ip: 127.0.0.1
port: 8901
debug: true
workers: 1
processes_pool_size: 10
# Use YAML's escape syntax \x1b instead of \033
log_format: "%(asctime)s.%(msecs)03d %(process)d \x1b[32m%(levelname)s:\x1b[0m [%(request_id)s|%(client_id)s] %(name)s %(message)s"
uvicorn_log_format: "%(asctime)s.%(msecs)03d %(process)d \x1b[32m%(levelname)s:\x1b[0m [-|-] %(name)s %(message)s"

openstack:
  allow_write: false
  ca_cert: ./tls-ca-bundle.pem
  insecure: false
  # Commands between service catalog refreshes for dynamic credentials
  # (OS_TOKEN/OS_URL headers). The catalog is fetched from OS_URL and cached
  # per worker process, and re-fetched after this many commands have used it.
  catalog_refresh_commands: 100
  # Prometheus/Aetos (metric-storage) connection used by `openstack metric ...`.
  # Required on RHOSO 18, where metric-storage is not in the Keystone catalog and
  # cannot be auto-discovered. Omit on RHOSO 19+ (discovered from Keystone).
  # Env vars PROMETHEUS_HOST/PROMETHEUS_PORT/PROMETHEUS_CA_CERT/PROMETHEUS_ROOT_PATH
  # override these values if set.
  #prometheus:
  #  host: metric-storage-prometheus.openstack.svc
  #  port: 9090
  #  ca_cert: ./tls-ca-bundle.pem
  #  root_path: null

openshift:
  allow_write: false
  insecure: false

# Incoming TLS settings for the MCP server
#tls:
#  ssl_certfile: ./cert.pem
#  ssl_keyfile: ./key.pem
#  ssl_keyfile_password: null
#  ssl_ca_certs: null

mcp_transport_security:
    token: supersecret
    enable_dns_rebinding_protection: false
    allowed_hosts:
      - "*:*"
    allowed_origins:
      - "http://*:*"
